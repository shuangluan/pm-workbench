{
  "name": "pm-evidence-workbench",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @pew/web",
    "build": "npm run build -w @pew/web",
    "start": "npm run start -w @pew/web",
    "access:reset": "tsx scripts/access-reset.ts",
    "doctor": "tsx scripts/doctor.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "check": "npm run typecheck && npm run test",
    "db:generate": "npm run generate -w @pew/db"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "tsx": "4.21.1"
  }
}
