# Copy to .env for the Docker Compose setup. Never commit .env.
# Password for the bundled Postgres container (not exposed outside Docker).
PEW_DB_PASSWORD=replace-with-a-long-random-string

# Optional overrides for running without Docker (defaults shown):
# PEW_DATA_DIR=.data
# PEW_DATABASE_URL=pglite:.data/pglite
# PORT=3210
# Base64 of 32 random bytes. If unset, a random key is created at <data dir>/master.key.
# PEW_MASTER_KEY=
